# --- 1. CONFIGURATION ---
CSV_FILENAME = "Crop_recommendation.csv"

# TWILIO KEYS (Enter your keys here) #take it from the twilio website
TWILIO_SID = ""
TWILIO_AUTH = ""
TWILIO_PHONE = ""
TWILIO_WHATSAPP_FROM = ""

# --- 2. KNOWLEDGE BASE ---
class PreInstalledKnowledgeBase:
    def __init__(self, filename):
        self.df = None
        self.crops = []
        self.filename = filename
        self.load_data()

    def load_data(self):
        if not os.path.exists(self.filename):
            print(f"Error: File '{self.filename}' not found!")
            return
        try:
            self.df = pd.read_csv(self.filename)
            self.df.columns = [c.lower().strip() for c in self.df.columns]

            # Find crop column
            if 'label' in self.df.columns: self.crop_col = 'label'
            elif 'crop' in self.df.columns: self.crop_col = 'crop'
            else: return

            self.crops = [c.lower() for c in self.df[self.crop_col].unique()]
            print(f"Knowledge Base Loaded: {len(self.crops)} crops.")
        except Exception as e:
            print(f"Error reading CSV: {e}")

    def get_profile(self, crop_name):
        if self.df is None or crop_name not in self.crops: return None
        subset = self.df[self.df[self.crop_col] == crop_name]
        profile = {}
        if 'temperature' in self.df.columns: profile['temp_max'] = subset['temperature'].max()
        if 'rainfall' in self.df.columns: profile['rain_opt'] = subset['rainfall'].mean()
        if 'n' in self.df.columns: profile['N'] = int(subset['n'].mean())
        if 'p' in self.df.columns: profile['P'] = int(subset['p'].mean())
        if 'k' in self.df.columns: profile['K'] = int(subset['k'].mean())
        return profile

# --- 3. NOTIFICATION SYSTEM (Updated for Dynamic Number) ---
class NotificationSystem:
    def __init__(self):
        self.enabled = False
        if TWILIO_SID and TWILIO_AUTH:
            self.client = Client(TWILIO_SID, TWILIO_AUTH)
            self.enabled = True
        else:
            print("Twilio Keys missing. Notifications will be simulated.")

    def send_whatsapp(self, to_number, message):
        if not to_number.startswith("whatsapp:"):
            to_number = f"whatsapp:{to_number}"

        print(f"\nSENDING WHATSAPP TO {to_number}...")

        if self.enabled:
            try:
                msg = self.client.messages.create(
                    body=message,
                    from_=TWILIO_WHATSAPP_FROM,
                    to=to_number
                )
                print(f"WhatsApp Sent! (SID: {msg.sid})")
            except Exception as e:
                print(f"WhatsApp Failed: {e}")
                print("   (Note: For Sandbox, user must send 'join <code_word>' to Twilio first)")
        else:
            print("Simulation: WhatsApp sent to screen")
    def send_sms(self, to_number, message):
        print(f"\n SENDING SMS TO {to_number}...")

        if self.enabled:
            try:
                msg = self.client.messages.create(
                    body=message,
                    from_=TWILIO_PHONE,
                    to=to_number
                )
                print(f"SMS Sent! (SID: {msg.sid})")
            except Exception as e:
                print(f"SMS Failed: {e}")
        else:
            print("Simulation: SMS sent to screen")

# --- VOICE PROCESSING LOGIC ---
import whisper
import re
from gtts import gTTS

print("Loading Whisper model (this may take a moment)...")
try:
    whisper_model = whisper.load_model("base")
except Exception as e:
    print(f"Error loading Whisper model: {e}")
    whisper_model = None

def get_voice_input(filepath, translate_to_en=True):
    if not filepath or whisper_model is None:
        return "", None

    print(f"Processing audio file: {filepath}")
    result = whisper_model.transcribe(filepath)
    transcribed_text = result["text"].strip()
    detected_lang = result["language"]

    print(f"Heard ({detected_lang}): {transcribed_text}")

    if translate_to_en and detected_lang != "en":
        translator = Translator()
        try:
            english_text = translator.translate(transcribed_text, dest="en").text
            print(f"Translated to English: {english_text}")
            return english_text, detected_lang
        except Exception as e:
            print(f"Translation failed: {e}")
            return transcribed_text, detected_lang

    return transcribed_text, detected_lang

def clean_phone_number(text):
    # Extract only digits and the '+' sign
    return "".join(re.findall(r'[\d+]', text))

def generate_voice_output(text, lang="en", filename="output.mp3"):
    try:
        tts = gTTS(text=text, lang=lang)
        tts.save(filename)
        return filename
    except Exception as e:
        print(f"Error generating voice output: {e}")
        return None

# --- 4. MAIN ENGINE ---
class CropDigitalTwin:
    def __init__(self):
        self.kb = PreInstalledKnowledgeBase(CSV_FILENAME)
        self.notifier = NotificationSystem()
        self.translator = Translator()
        self.lang_map = {
            "Punjab": "pa", "Tamil Nadu": "ta", "Maharashtra": "mr",
            "Karnataka": "kn", "West Bengal": "bn", "Gujarat": "gu",
            "Uttar Pradesh": "hi", "Bihar": "hi", "Kerala": "ml",
            "Andhra Pradesh": "te", "Telangana": "te", "Odisha": "or"
        }

    def set_location(self, place):
        try:
            url = "https://geocoding-api.open-meteo.com/v1/search"
            res = requests.get(url, params={"name": place, "count": 1}).json()
            if "results" in res:
                data = res["results"][0]
                self.loc_name = data['name']
                self.state = data.get('admin1', 'India')
                self.lat, self.lon = data['latitude'], data['longitude']
                return True
            print("Location not found.")
            return False
        except:
            return False

    def run_analysis(self, crop_name, receiver_phone):
        crop_name = crop_name.lower()
        profile = self.kb.get_profile(crop_name)

        if not profile:
            msg = f"Crop '{crop_name}' not found."
            print(msg)
            return msg, "", None

        # Fetch Weather
        url = "https://api.open-meteo.com/v1/forecast"
        params = {
            "latitude": self.lat, "longitude": self.lon,
            "current_weather": True,
            "daily": ["precipitation_sum", "temperature_2m_max"],
            "hourly": "relativehumidity_2m"
        }
        try:
            w = requests.get(url, params=params).json()
            temp = w['current_weather']['temperature']
            rain = w['daily']['precipitation_sum'][0]
            humid = w['hourly']['relativehumidity_2m'][datetime.now().hour]
        except:
            msg = "Weather API Error."
            print(msg)
            return msg, "", None

        # Generate Insights
        health_msg = "Healthy"
        if 'temp_max' in profile and temp > profile['temp_max'] + 2:
            health_msg = f"HEAT STRESS (Curr: {temp}°C > Max: {profile['temp_max']:.1f}°C)"

        fert_msg = "Safe to Fertilize"
        if rain > 5:
            fert_msg = f"STOP FERTILIZER (Rain: {rain}mm)"

        # English Report
        english_report1 = (f"*{crop_name.upper()} ADVISORY* ({self.loc_name})\n"
                          f"Temp: {temp}°C | Humid: {humid}%\n"
                          f"Health: {health_msg}\n"
                          f"Action: {fert_msg}")
        english_report2 = (f" {crop_name.upper()} ADVISORY ({self.loc_name})\n"
                          f" Temp: {temp}°C , Humid: {humid}%\n")
        if 'N' in profile:
            english_report1 += f"\n Ideal NPK: {profile['N']}-{profile['P']}-{profile['K']}"
            english_report2 += f"\n Ideal NPK: {profile['N']}-{profile['P']}-{profile['K']}"

        # Translated Report
        target_lang = self.lang_map.get(self.state, "en")
        local_report = ""
        if target_lang != "en":
            try:
                core_msg = f"Health: {health_msg}. Action: {fert_msg}."
                local_report = self.translator.translate(core_msg, dest=target_lang).text
            except:
                pass

        # Final Message
        final_message1 = english_report1
        final_message2= english_report2
        if local_report:
            final_message1 += f"\n\n{self.state} ({target_lang}):\n{local_report}"
            final_message2 += f"\n\n{local_report}"

        print("\n" + "="*40)
        print(final_message1)
        print("="*40)

        print("\n" + "="*40)
        print(final_message2)
        print("="*40)

        # Pass the dynamic number here
        self.notifier.send_whatsapp(receiver_phone, final_message1)
        self.notifier.send_sms(receiver_phone, final_message2)

        # Generate Voice Output
        audio_file = None
        if target_lang != "en" and local_report:
             audio_file = generate_voice_output(local_report, lang=target_lang)
        else:
             audio_file = generate_voice_output(english_report2, lang="en")

        return final_message1, local_report if local_report else english_report2, audio_file

# --- 5. EXECUTION (UI Integration) ---
import gradio as gr

twin = CropDigitalTwin()

def process_inputs(crop_audio, loc_audio, phone_audio):
    if twin.kb.df is None:
        return "Knowledge base not loaded.", "", None

    # 1. Process Crop
    raw_crop, _ = get_voice_input(crop_audio, translate_to_en=True)
    u_crop = re.sub(r'[^\w\s]', '', raw_crop).strip()
    if not u_crop: return "Could not detect Crop Name.", "", None

    # 2. Process Location
    raw_loc, _ = get_voice_input(loc_audio, translate_to_en=True)
    u_loc = re.sub(r'[^\w\s]', '', raw_loc).strip()
    if not u_loc: return "Could not detect Location.", "", None

    # 3. Process Phone Number
    raw_phone, _ = get_voice_input(phone_audio, translate_to_en=False)
    u_phone = clean_phone_number(raw_phone)
    if not u_phone: return "Could not detect Phone Number.", "", None

    print(f"Parsed -> Crop: {u_crop}, Location: {u_loc}, Phone: {u_phone}")

    if twin.set_location(u_loc):
        return twin.run_analysis(u_crop, u_phone)
    else:
        return "Location not found via geocoding API.", "", None

with gr.Blocks(title="Crop Digital Twin") as demo:
    gr.Markdown("# 🌾 Crop Digital Twin AI")
    gr.Markdown("Speak into your microphone to provide the Crop Name, your Location, and your Phone Number.")

    with gr.Row():
        with gr.Column():
            crop_in = gr.Audio(sources=["microphone"], type="filepath", label="🎙️ 1. Say Crop Name (e.g., Rice)")
            loc_in = gr.Audio(sources=["microphone"], type="filepath", label="🎙️ 2. Say Location (e.g., Ludhiana)")
            phone_in = gr.Audio(sources=["microphone"], type="filepath", label="🎙️ 3. Say Phone Number")
            submit_btn = gr.Button("Analyze", variant="primary")

        with gr.Column():
            report_out = gr.Textbox(label="Full Advisory Report", lines=8)
            local_text_out = gr.Textbox(label="Local Language Message", lines=3)
            audio_out = gr.Audio(label="🔊 Voice Advisory", autoplay=True)

    submit_btn.click(
        fn=process_inputs,
        inputs=[crop_in, loc_in, phone_in],
        outputs=[report_out, local_text_out, audio_out]
    )

demo.launch(debug=True, share=True)
